{
  "name": "SMAMonitoreoBazurto — Orquestador n8n conectado a FastAPI + SQLite",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "cron-monitoreo",
      "name": "Ciclo Monitoreo (15 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/caso-uso-1",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"zona_id\": \"zona_3\",\n  \"forzar_duplicada\": false,\n  \"comunidad_confirma\": true\n}",
        "options": {}
      },
      "id": "http-cu01",
      "name": "Ejecutar CU-01 (Agentes + SQLite)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.resultado_acl }}",
              "operation": "notEqual",
              "value2": "INFORM-DONE"
            }
          ]
        }
      },
      "id": "if-alerta-fallo",
      "name": "¿Requiere Supervisión CU-02?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/caso-uso-2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"zona_id\": \"zona_3\",\n  \"simular_sin_confirmacion\": true,\n  \"simular_sensor_caido\": false\n}",
        "options": {}
      },
      "id": "http-cu02",
      "name": "Ejecutar CU-02 (Supervisor Escala)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 220]
    }
  ],
  "connections": {
    "Ciclo Monitoreo (15 min)": {
      "main": [
        [
          {
            "node": "Ejecutar CU-01 (Agentes + SQLite)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ejecutar CU-01 (Agentes + SQLite)": {
      "main": [
        [
          {
            "node": "¿Requiere Supervisión CU-02?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Requiere Supervisión CU-02?": {
      "main": [
        [
          {
            "node": "Ejecutar CU-02 (Supervisor Escala)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
